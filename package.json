{
  "name": "codehired",
  "private": true,
  "description": "Job board for developers: search, apply and track programming jobs",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @codehired/api dev",
    "dev:web": "pnpm --filter @codehired/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:seed": "pnpm --filter @codehired/api db:seed"
  }
}
