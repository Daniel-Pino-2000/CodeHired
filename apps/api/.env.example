# Port the API listens on
PORT=3000

# libSQL database URL: a local file in development (created automatically),
# `libsql://<database>-<user>.turso.io` for a hosted Turso database
DATABASE_URL=file:codehired.db

# Only needed for Turso: create one with `turso db tokens create <database>`
DATABASE_AUTH_TOKEN=

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
