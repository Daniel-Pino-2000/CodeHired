# Port the API listens on
PORT=3000

# `production` on hosted deployments: the fictional sample jobs are only seeded in development
NODE_ENV=development

# libSQL database URL: a local file in development (created automatically),
# `libsql://<database>-<user>.turso.io` for a hosted Turso database
DATABASE_URL=file:codehired.db

# Only needed for Turso: create one with `turso db tokens create <database>`
DATABASE_AUTH_TOKEN=

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Signs the session cookies. Required outside development (sign-in fails without it); generate
# one with `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# Development falls back to a fixed secret. Never commit real values.
JWT_SECRET=

# Proxy hops in front of the API whose X-Forwarded-For is trusted for rate limiting
# (default: 0 in development, 1 elsewhere, which fits Vercel)
TRUST_PROXY=

# Adzuna API (`pnpm ingest --source=adzuna`): a free key from https://developer.adzuna.com/.
# Leave empty to skip the source. Never commit real values.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs API (`pnpm ingest --source=usajobs`): a free key from https://developer.usajobs.gov/,
# and the email address it was issued to, which the API requires as the User-Agent.
# Leave empty to skip the source. Never commit real values.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# JSearch API by OpenWeb Ninja (`pnpm ingest --source=jsearch`): a free key from
# https://app.openwebninja.com/api/jsearch (200 requests a month; CodeHired stops at 190).
# Leave empty to skip the source. Never commit real values.
JSEARCH_API_KEY=
