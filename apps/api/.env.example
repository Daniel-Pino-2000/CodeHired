# Port the API listens on
PORT=3000

# `production` on hosted deployments: the fictional sample jobs are only seeded in development
NODE_ENV=development

# libSQL database URL: a local file in development (created automatically),
# `libsql://<database>-<user>.turso.io` for a hosted Turso database
DATABASE_URL=file:codehired.db

# Only needed for Turso: create one with `turso db tokens create <database>`
DATABASE_AUTH_TOKEN=

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Adzuna API (`pnpm ingest --source=adzuna`): a free key from https://developer.adzuna.com/.
# Leave empty to skip the source. Never commit real values.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
